# The MCP server needs NO key: it falls back to DuckDuckGo search.
# Everything below is optional.

# For the Streamlit client, which asks Gemini to drive the tools.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional search providers. Without either of these the server uses
# DuckDuckGo, which needs no key at all.
TAVILY_API_KEY=             # free tier, better snippets: https://tavily.com
SERPAPI_API_KEY=            # paid, real Google SERP: https://serpapi.com
