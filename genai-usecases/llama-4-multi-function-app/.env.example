# Required. Every feature runs on Llama 4 via Groq.
# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=your-groq-api-key-here

# Optional. Enables the Gemini fallback and RAG evaluation.
# Without it, a failed Groq call is reported as an error rather than
# silently answered by something else.
# https://aistudio.google.com/app/apikey  (free tier)
GOOGLE_API_KEY=your-google-api-key-here

# Optional limits
# MAX_UPLOAD_BYTES=26214400
# MAX_IMAGE_BYTES=10485760
# API_PORT=8000
# UI_PORT=8501
