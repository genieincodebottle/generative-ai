# Hosted backend. Nothing to download.
# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=your-groq-api-key-here

# Local backend. The Llama Prompt Guard 2 repos are GATED: create a token and
# accept the licence at https://huggingface.co/meta-llama/Llama-Prompt-Guard-2-22M
# with the same account, or the download fails with a 401.
# https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# Optional
# PROMPT_GUARD_BACKEND=groq
# MAX_TEXT_LENGTH=10000
# API_PORT=8000
# UI_PORT=8501
