GOOGLE_API_KEY=your-google-api-key-here

# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=your-groq-api-key-here

# Optional limits
# MAX_UPLOAD_BYTES=31457280
# MAX_FILES=10
# MAX_SESSIONS=12
# API_PORT=8000
# UI_PORT=8501
